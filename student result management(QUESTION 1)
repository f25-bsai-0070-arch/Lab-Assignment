students = []

def result(python, ai, maths):
    total = python + ai + maths
    percentage = total / 3

    if percentage >= 80:
        grade = "A"
    elif percentage >= 70:
        grade = "B"
    elif percentage >= 60:
        grade = "C"
    elif percentage >= 50:
        grade = "D"
    else:
        grade = "F"

    return total, percentage, grade


for i in range(5):
    print("\nStudent", i + 1)

    name = input("Enter name: ")
    roll = input("Enter roll number: ")

    python = float(input("Enter Python marks: "))
    ai = float(input("Enter AI marks: "))
    maths = float(input("Enter Maths marks: "))

    total, percentage, grade = result(python, ai, maths)

    student = {
        "Name": name,
        "Roll": roll,
        "Total": total,
        "Percentage": percentage,
        "Grade": grade
    }

    students.append(student)


highest = students[0]

for s in students:
    print("\nName:", s["Name"])
    print("Roll Number:", s["Roll"])
    print("Total Marks:", s["Total"])
    print("Percentage:", round(s["Percentage"], 2))
    print("Grade:", s["Grade"])

    if s["Percentage"] > highest["Percentage"]:
        highest = s


print("\nHighest Percentage Student:")
print("Name:", highest["Name"])
print("Percentage:", round(highest["Percentage"], 2))


with open("results.txt", "w") as file:
    for s in students:
        file.write(str(s) + "\n")

print("\nResults saved in results.txt")
