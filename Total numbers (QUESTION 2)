def analyze(sentence):
    words = sentence.split()

    print("Total words:", len(words))
    print("Total characters:", len(sentence))

    if len(words) > 0:
        longest = words[0]
        shortest = words[0]

        for word in words:
            if len(word) > len(longest):
                longest = word
            if len(word) < len(shortest):
                shortest = word

        print("Longest word:", longest)
        print("Shortest word:", shortest)
    else:
        longest = ""
        shortest = ""
        print("Longest word: None")
        print("Shortest word: None")

    vowels = 0
    for letter in sentence.lower():
        if letter in "aeiou":
            vowels = vowels + 1

    print("Total vowels:", vowels)

    unique_words = set(words)
    print("Unique words:", unique_words)

    alphabetical = sorted(words)
    print("Alphabetical order:", alphabetical)

    with open("word_analysis.txt", "w") as file:
        file.write("Sentence: " + sentence + "\n")
        file.write("Total words: " + str(len(words)) + "\n")
        file.write("Total characters: " + str(len(sentence)) + "\n")
        file.write("Longest word: " + longest + "\n")
        file.write("Shortest word: " + shortest + "\n")
        file.write("Total vowels: " + str(vowels) + "\n")
        file.write("Unique words: " + str(unique_words) + "\n")
        file.write("Alphabetical order: " + str(alphabetical) + "\n")

    print("Analysis saved in word_analysis.txt")


sentence = input("Enter a sentence: ")
analyze(sentence)
